{{ 'body-type-home.css' | asset_url | stylesheet_tag }}

<section id="meet-the-herbs" class="bt-home bt-herbs color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="bt-home__heading-row">
      <div>
        <p class="bt-home__section-name">{{ section.settings.section_name | escape }}</p>
        <h2 class="bt-home__heading">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <div class="bt-home__intro rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="bt-herbs__rail" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign asset_name = blank
          case block.settings.asset_key
            when 'huangqi'
              assign asset_name = 'thyling-herb-huangqi.png'
            when 'suanzaoren'
              assign asset_name = 'thyling-herb-suanzaoren.png'
            when 'wuzhimaotao'
              assign asset_name = 'thyling-herb-wuzhimaotao.png'
            when 'heye'
              assign asset_name = 'thyling-herb-heye.png'
            when 'luohanguo'
              assign asset_name = 'thyling-herb-luohanguo.png'
            when 'lingzhi'
              assign asset_name = 'thyling-herb-lingzhi.jpg'
            when 'xiyangshen'
              assign asset_name = 'thyling-herb-xiyangshen.jpg'
            when 'foshou'
              assign asset_name = 'thyling-herb-foshou.jpg'
            when 'hongshen'
              assign asset_name = 'thyling-herb-hongshen.jpg'
            when 'yuzhu'
              assign asset_name = 'thyling-herb-yuzhu.png'
          endcase
        -%}
        <article class="bt-herb" role="listitem" {{ block.shopify_attributes }}>
          <div class="bt-herb__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 25vw, 78vw',
                  alt: block.settings.name
              }}
            {%- elsif asset_name != blank -%}
              <img
                src="{{ asset_name | asset_url }}"
                width="1080"
                height="1620"
                loading="lazy"
                alt="{{ block.settings.name | escape }} — {{ block.settings.origin | escape }}"
              >
            {%- else -%}
              <div class="bt-herb__placeholder" aria-label="Ingredient image placeholder">
                <span>{{ forloop.index | prepend: '0' }}</span>
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          <div class="bt-herb__content">
            <div class="bt-herb__meta">
              <h3>{{ block.settings.name | escape }}</h3>
              <span>{{ block.settings.origin | escape }}</span>
            </div>
            <p>{{ block.settings.text | escape }}</p>
            {%- if block.settings.status != blank -%}
              <span class="bt-home__chip">{{ block.settings.status | escape }}</span>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "THYLING herb stories",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_name",
      "label": "Section name",
      "default": "Meet the herbs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every formula begins with a source"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Each ingredient carries a place, a season, and a way of waiting. These are the origins behind the THYLING ritual.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "herb",
      "name": "Herb story",
      "settings": [
        {
          "type": "select",
          "id": "asset_key",
          "label": "Bundled THYLING poster",
          "default": "suanzaoren",
          "options": [
            { "value": "huangqi", "label": "Huang Qi" },
            { "value": "suanzaoren", "label": "Suan Zao Ren" },
            { "value": "wuzhimaotao", "label": "Five-Fingered Fig Root" },
            { "value": "heye", "label": "Lotus Leaf" },
            { "value": "luohanguo", "label": "Luo Han Guo" },
            { "value": "lingzhi", "label": "Lingzhi" },
            { "value": "xiyangshen", "label": "American Ginseng" },
            { "value": "foshou", "label": "Fingered Citron" },
            { "value": "hongshen", "label": "Red Ginseng" },
            { "value": "yuzhu", "label": "Yu Zhu" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Herb name"
        },
        {
          "type": "text",
          "id": "origin",
          "label": "Origin",
          "default": "Origin"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Story excerpt",
          "default": "A place-led ingredient story from the THYLING source archive."
        },
        {
          "type": "text",
          "id": "status",
          "label": "Status label",
          "default": "Origin story"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "THYLING herb stories",
      "blocks": [
        {
          "type": "herb",
          "settings": {
            "asset_key": "suanzaoren",
            "name": "Suan Zao Ren",
            "origin": "Neiqiu, Hebei",
            "text": "Harvested around the turning of autumn, when timing and patience matter as much as place.",
            "status": "Seasonal harvest"
          }
        },
        {
          "type": "herb",
          "settings": {
            "asset_key": "luohanguo",
            "name": "Luo Han Guo",
            "origin": "Yongfu, Guangxi",
            "text": "A mountain fruit allowed to ripen in its own time before a slow, careful drying process.",
            "status": "Mountain origin"
          }
        },
        {
          "type": "herb",
          "settings": {
            "asset_key": "wuzhimaotao",
            "name": "Five-Fingered Fig Root",
            "origin": "Southern China",
            "text": "A familiar root in southern seasonal food traditions, remembered through family kitchens.",
            "status": "Food tradition"
          }
        },
        {
          "type": "herb",
          "settings": {
            "asset_key": "lingzhi",
            "name": "Lingzhi",
            "origin": "China",
            "text": "An enduring botanical symbol in traditional wellness culture and everyday ritual.",
            "status": "Heritage ingredient"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{{ 'body-type-home.css' | asset_url | stylesheet_tag }}

<section id="the-wisdom" class="bt-home bt-formula color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="bt-formula__panel">
      <div class="bt-formula__visual">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 990px) 52vw, 100vw',
              alt: section.settings.heading
          }}
        {%- else -%}
          <img
            src="{{ 'thyling-herb-suanzaoren.png' | asset_url }}"
            width="1080"
            height="1620"
            loading="lazy"
            alt="Suan Zao Ren at its seasonal source"
          >
        {%- endif -%}
      </div>

      <div class="bt-formula__content">
        <p class="bt-home__section-name">{{ section.settings.section_name | escape }}</p>
        <h2 class="bt-home__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="bt-home__intro rte">{{ section.settings.text }}</div>
        {%- endif -%}

        <ol class="bt-formula__steps">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span>{{ forloop.index }}</span>
              <div>
                <h3>{{ block.settings.title | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>

        <div class="bt-formula__actions">
          <a class="button button--primary" href="{{ section.settings.quiz_link | default: '/pages/body-type-quiz' }}">
            {{ section.settings.quiz_label | escape }}
          </a>
          <a class="bt-home__text-link" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">
            {{ section.settings.shop_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="bt-formula__note">{{ section.settings.note | escape }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "THYLING quiz journey",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Formula image"
    },
    {
      "type": "text",
      "id": "section_name",
      "label": "Section name",
      "default": "The wisdom, made personal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A clearer path from body signals to a daily formula"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Sixty-three questions are scored across nine constitution dimensions. A fixed rule engine then identifies your strongest tendencies and applies safety-first product rules.</p>"
    },
    {
      "type": "text",
      "id": "quiz_label",
      "label": "Quiz button label",
      "default": "Find my formula"
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Quiz link"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop link label",
      "default": "Browse every formula"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Reference note",
      "default": "Results are for general wellness and lifestyle reference only and are not a medical diagnosis."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Recommendation step",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "A short explanation of this step."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "THYLING quiz journey",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Share how you feel today",
            "text": "Answer a short set of lifestyle and body-signal questions."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "See your strongest tendency",
            "text": "Receive a plain-language wellness reference based on your answers."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Explore a matched ritual",
            "text": "Continue to a relevant product page with the recommendation context preserved."
          }
        }
      ]
    }
  ]
}
{% endschema %}

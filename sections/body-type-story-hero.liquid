{{ 'body-type-quiz.css' | asset_url | stylesheet_tag }}

<section class="body-type-story-hero color-{{ section.settings.color_scheme }}">
  <div class="body-type-story-hero__content page-width">
    <div class="body-type-story-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="body-type-story-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="body-type-story-hero__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading | escape }}
      </h1>
      {%- if section.settings.text != blank -%}
        <div class="body-type-story-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="body-type-story-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{ section.settings.primary_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.secondary_link | default: section.settings.quiz_page_url }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
    <div class="body-type-story-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            widths: '520, 760, 980, 1200, 1400',
            sizes: '(min-width: 990px) 44vw, 100vw',
            alt: section.settings.heading
        }}
      {%- else -%}
        <img
          src="{{ 'thyling-herb-luohanguo.png' | asset_url }}"
          width="1080"
          height="1620"
          loading="eager"
          alt="Luo Han Guo growing in its mountain origin"
        >
      {%- endif -%}
      <span class="body-type-story-hero__seal" aria-hidden="true">时令<br>而养</span>
    </div>
    <div class="body-type-story-hero__trust" aria-label="How the THYLING quiz works">
      {%- for block in section.blocks -%}
        <div class="body-type-story-hero__trust-item" {{ block.shopify_attributes }}>
          {{ block.settings.text | escape }}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Body type story hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Traditional rhythm, made personal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wellness begins by noticing your own rhythm"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h0",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover herbs in season, understand your constitution profile, and explore a daily blend through THYLING's deterministic wellness guide.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Take the Constitution Quiz"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Explore the blends"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "url",
      "id": "quiz_page_url",
      "label": "Fallback quiz page URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Personalized daily support"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Body type story hero",
      "blocks": [
        { "type": "trust_item", "settings": { "text": "63 considered questions" } },
        { "type": "trust_item", "settings": { "text": "Nine constitution dimensions" } },
        { "type": "trust_item", "settings": { "text": "Rule-based recommendations" } }
      ]
    }
  ]
}
{% endschema %}

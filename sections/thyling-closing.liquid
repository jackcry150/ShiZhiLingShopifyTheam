{{ 'thyling-pages.css' | asset_url | stylesheet_tag }}

<section class="tp tp-wrap tp-closing">
  <div class="tp-story tp-story--end">
    <h2 class="tp-h2">{{ section.settings.heading | escape | newline_to_br }}</h2>
    <div>
      {%- if section.settings.text != blank -%}<p class="tp-copy">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <p><a class="tp-btn" href="{{ section.settings.button_link | default: '/pages/membership' }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">⟶</span></a></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "THYLING closing",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "KEEP THE\nRITUAL\nGOING." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Seasonal herbal stories, new rituals and thoughtful notes from THYLING." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore membership" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to /pages/membership." }
  ],
  "presets": [{ "name": "THYLING closing" }]
}
{% endschema %}
